{
  "name": "beifahrer-cli",
  "version": "0.1.4",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "The `beifahrer` binary: the loopback bridge the extension connects to, exposed as an MCP server and a small CLI. Bundled to one .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify build src/index.ts --app gjs --outfile dist/beifahrer.gjs.mjs",
    "build:node": "gjsify build src/index.ts --app node --outfile dist/beifahrer.node.mjs",
    "start": "gjsify run dist/beifahrer.gjs.mjs",
    "test": "gjsify test",
    "test:mcp": "node tests/integration/mcp-gjs-smoke.mjs"
  },
  "gjsify": {
    "ship": {
      "appId": "eu.jumplink.beifahrer",
      "binaryName": "beifahrer",
      "kind": "cli",
      "name": "Beifahrer",
      "bundle": {
        "linux": "dist/beifahrer.gjs.mjs",
        "darwin": "dist/beifahrer.node.mjs",
        "win32": "dist/beifahrer.node.mjs"
      },
      "app": {
        "darwin": "node",
        "win32": "node"
      },
      "developer": {
        "id": "eu.jumplink",
        "name": "Pascal Garber",
        "email": "pascal@jumplink.eu"
      },
      "summary": "Browser bridge for AI agents, under a per-site policy you control",
      "license": {
        "project": "AGPL-3.0-or-later"
      },
      "description": "beifahrer is the bridge between the beifahrer WebExtension and an AI agent, exposed as an MCP server. It listens on a loopback port from a fixed range; the extension, not the bridge, decides what the agent may read or change, and nothing leaves the machine.",
      "homepageUrl": "https://github.com/JumpLink/beifahrer",
      "bugtrackerUrl": "https://github.com/JumpLink/beifahrer/issues",
      "vcsBrowserUrl": "https://github.com/JumpLink/beifahrer",
      "flatpak": {
        "finishArgs": [
          "--share=network",
          "--filesystem=xdg-config/beifahrer:create"
        ]
      }
    },
    "excludeGlobals": [
      "document",
      "navigator",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist-test",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "dependencies": {
    "@beifahrer/core": "*",
    "@gjsify/adwaita-app": "0.54.0",
    "@gjsify/adwaita-core": "0.54.0",
    "@gjsify/mcp": "0.54.0",
    "@gjsify/node-gi": "0.54.0",
    "@gjsify/ws": "0.54.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.21.3",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@gjsify/node-runtime-darwin-arm64": "0.54.0",
    "@gjsify/node-runtime-darwin-x64": "0.54.0",
    "@gjsify/node-runtime-win32-x64": "0.54.0"
  },
  "devDependencies": {
    "@gjsify/cli": "0.54.0",
    "@gjsify/node-globals": "0.54.0",
    "@gjsify/rolldown-native": "0.54.0",
    "@gjsify/runtime": "0.54.0",
    "@gjsify/unit": "0.54.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3"
  }
}
