{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["filesystem", "har-format", "@gjsify/rolldown-plugin-gjsify/types"]
  },
  "include": ["./entrypoints/**/*", "./src/**/*", "./manifest.ts"]
}
