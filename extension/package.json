{
  "name": "beifahrer-extension",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "The beifahrer WebExtension: connects to the local bridge and serves the agent's requests under the per-origin policy the person sets. One source, built with WXT as MV3 for Chromium and MV2 for Firefox.",
  "scripts": {
    "postinstall": "wxt prepare",
    "check": "wxt prepare && tsc --noEmit",
    "lint": "gjsify lint .",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "@beifahrer/core": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
