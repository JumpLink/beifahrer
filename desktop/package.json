{
  "name": "beifahrer-desktop",
  "version": "0.1.13",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "The native libadwaita window for beifahrer: which agent sessions run and which browsers hang on them, read from the session registry (ADR 0015). It is a view and never a policy: it cannot pause, resume, switch a feature or change a site's level (ADR 0005, ADR 0017).",
  "main": "src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify build src/main.ts --app gjs --outfile dist/beifahrer-desktop.gjs.mjs --channel web",
    "build:node": "gjsify build src/main.ts --app node --outfile dist/beifahrer-desktop.node.mjs",
    "start": "gjsify run dist/beifahrer-desktop.gjs.mjs",
    "test": "gjsify test"
  },
  "gjsify": {
    "ship": {
      "appId": "eu.jumplink.beifahrer",
      "binaryName": "beifahrer-desktop",
      "kind": "app",
      "name": "Beifahrer",
      "channel": "web",
      "bundle": {
        "linux": "dist/beifahrer-desktop.gjs.mjs",
        "darwin": "dist/beifahrer-desktop.node.mjs",
        "win32": "dist/beifahrer-desktop.node.mjs"
      },
      "app": {
        "darwin": "node",
        "win32": "node"
      },
      "icon": "../data/icons/hicolor/scalable/apps/eu.jumplink.beifahrer.svg",
      "developer": {
        "id": "eu.jumplink",
        "name": "Pascal Garber",
        "email": "pascal@jumplink.eu"
      },
      "summary": "Browser bridge for AI agents, under a per-site policy you control",
      "description": [
        {
          "p": "Beifahrer lets an AI agent work in your own browser, with your own sessions and the tab you are looking at, instead of in a separate automated one."
        },
        {
          "p": "This window shows which agent sessions run and which browsers hang on them, the snippet that registers Beifahrer with your coding agent, and the pairing token to paste into each browser."
        },
        {
          "p": "It only looks. Every site is covered by a policy you set in the browser, and the window can neither change it nor pause the agent."
        }
      ],
      "categories": [
        "Development",
        "Utility"
      ],
      "keywords": [
        "Browser",
        "AI",
        "MCP",
        "Agent",
        "Automation"
      ],
      "branding": {
        "accentLight": "#d9c2f0",
        "accentDark": "#613583"
      },
      "contentRating": "oars-1.1",
      "license": {
        "project": "AGPL-3.0-or-later",
        "file": "../LICENSE"
      },
      "homepageUrl": "https://jumplink.eu/beifahrer/",
      "bugtrackerUrl": "https://github.com/JumpLink/beifahrer/issues",
      "vcsBrowserUrl": "https://github.com/JumpLink/beifahrer",
      "flatpak": {
        "finishArgs": [
          "--share=ipc",
          "--socket=wayland",
          "--socket=fallback-x11",
          "--device=dri",
          "--filesystem=xdg-config/beifahrer:ro",
          "--filesystem=xdg-run/beifahrer:ro"
        ]
      }
    },
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist-test",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "optionalDependencies": {
    "@gjsify/gtk-runtime-darwin-arm64": "0.64.2",
    "@gjsify/gtk-runtime-darwin-x64": "0.64.2",
    "@gjsify/gtk-runtime-win32-x64": "0.64.2",
    "@gjsify/node-runtime-darwin-arm64": "0.64.2",
    "@gjsify/node-runtime-darwin-x64": "0.64.2",
    "@gjsify/node-runtime-win32-x64": "0.64.2"
  },
  "dependencies": {
    "@beifahrer/core": "*",
    "@beifahrer/local": "*",
    "@gjsify/adwaita-app": "0.64.2",
    "@gjsify/adwaita-core": "0.64.2",
    "@gjsify/distribution": "0.64.2",
    "@gjsify/node-gi": "0.64.2"
  },
  "devDependencies": {
    "@girs/adw-1": "5.4.0",
    "@girs/gdk-4.0": "5.4.0",
    "@girs/gio-2.0": "5.4.0",
    "@girs/glib-2.0": "5.4.0",
    "@girs/gtk-4.0": "5.4.0",
    "@gjsify/cli": "0.64.2",
    "@gjsify/node-globals": "0.64.2",
    "@gjsify/rolldown-native": "0.64.2",
    "@gjsify/runtime": "0.64.2",
    "@gjsify/unit": "0.64.2",
    "@types/node": "^26.6.2"
  }
}
