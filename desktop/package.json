{
  "name": "beifahrer-desktop",
  "version": "0.1.4",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "The native libadwaita window for beifahrer: which agent sessions run and which browsers hang on them, read from the session registry (ADR 0015). It is a view and never a policy: it cannot pause, resume, switch a feature or change a site's level (ADR 0005, ADR 0017).",
  "main": "src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify build src/main.ts --app gjs --outfile dist/beifahrer-desktop.gjs.mjs",
    "build:node": "gjsify build src/main.ts --app node --outfile dist/beifahrer-desktop.node.mjs",
    "start": "gjsify run dist/beifahrer-desktop.gjs.mjs",
    "test": "gjsify test"
  },
  "gjsify": {
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist-test",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "dependencies": {
    "@beifahrer/core": "*",
    "@beifahrer/local": "*",
    "@gjsify/adwaita-app": "0.54.0",
    "@gjsify/adwaita-core": "0.54.0",
    "@gjsify/node-gi": "0.54.0"
  },
  "devDependencies": {
    "@girs/adw-1": "5.4.0",
    "@girs/gio-2.0": "5.4.0",
    "@girs/glib-2.0": "5.4.0",
    "@girs/gtk-4.0": "5.4.0",
    "@gjsify/cli": "0.54.0",
    "@gjsify/node-globals": "0.54.0",
    "@gjsify/rolldown-native": "0.54.0",
    "@gjsify/runtime": "0.54.0",
    "@gjsify/unit": "0.54.0",
    "@types/node": "^26.6.2"
  }
}
