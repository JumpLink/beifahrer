{
  "name": "beifahrer",
  "version": "0.1.14",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "homepage": "https://jumplink.eu/beifahrer/",
  "type": "module",
  "description": "Beifahrer \u2014 let an AI agent ride along in the browser you already use (Firefox, Chromium), under a per-site policy you control. A WebExtension plus an MCP server that runs on GJS via gjsify.",
  "workspaces": [
    "packages/*",
    "app",
    "desktop",
    "extension"
  ],
  "scripts": {
    "check": "gjsify foreach -A check",
    "lint": "gjsify foreach -A lint && oxlint --deny-warnings tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "docs:links": "node tools/check-doc-links.mjs",
    "version:check": "node tools/version.mjs check",
    "version:set": "node tools/version.mjs set",
    "build": "gjsify workspace beifahrer-cli build && gjsify workspace beifahrer-extension build",
    "start": "gjsify workspace beifahrer-cli start",
    "test": "gjsify workspace beifahrer-cli test"
  },
  "devDependencies": {
    "@gjsify/cli": "0.64.7",
    "@gjsify/site": "0.64.7"
  },
  "gjsify": {
    "site": {
      "metainfo": "data/eu.jumplink.beifahrer.metainfo.xml",
      "base": "/beifahrer/",
      "url": "https://jumplink.eu/beifahrer/",
      "languages": [
        "en",
        "de"
      ],
      "defaultLanguage": "en",
      "repository": "JumpLink/beifahrer",
      "icon": "data/icons/hicolor/scalable/apps/eu.jumplink.beifahrer.svg",
      "releaseAssets": true,
      "pageTranslations": "site/po",
      "components": [
        {
          "id": "bridge",
          "name": "Bridge",
          "summary": "The MCP server your coding agent connects to. Every setup needs it.",
          "match": "^beifahrer[-_][0-9.]+-[0-9]+[._]|^eu\\.jumplink\\.beifahrer\\.Cli-"
        },
        {
          "id": "extension",
          "name": "Browser extension",
          "summary": "Beifahrer's half inside the browser. Pair it with the bridge using the token the bridge shows.",
          "match": "\\.xpi$|-mv[23]\\.zip$"
        },
        {
          "id": "window",
          "name": "Desktop window",
          "summary": "Optional. Shows which agent sessions run, which browsers hang on them, and the pairing token to paste."
        }
      ],
      "downloads": [
        {
          "platform": "firefox",
          "format": "store",
          "component": "extension",
          "available": false
        },
        {
          "platform": "chromium",
          "format": "store",
          "component": "extension",
          "available": false
        },
        {
          "platform": "firefox",
          "format": "source",
          "component": "extension",
          "url": "https://github.com/JumpLink/beifahrer#from-source"
        },
        {
          "platform": "chromium",
          "format": "source",
          "component": "extension",
          "url": "https://github.com/JumpLink/beifahrer#from-source"
        }
      ],
      "screenshots": {
        "source": "merge",
        "items": [
          {
            "from": 0,
            "variants": {
              "desktop-light": "docs/images/popup-light.png",
              "desktop-dark": "docs/images/popup-dark.png"
            }
          },
          {
            "from": 1,
            "variants": {
              "desktop-light": "docs/images/options-light.png",
              "desktop-dark": "docs/images/options-dark.png"
            }
          },
          {
            "from": 2,
            "variants": {
              "desktop-light": "docs/images/confirm-light.png",
              "desktop-dark": "docs/images/confirm-dark.png"
            }
          }
        ]
      },
      "privacy": {
        "statements": {
          "en": "docs/store/privacy.md",
          "de": "docs/store/privacy.de.md"
        }
      },
      "legalNotice": {
        "statements": {
          "en": "docs/store/legal-notice.md",
          "de": "docs/store/legal-notice.de.md"
        }
      },
      "developerUrl": "https://jumplink.eu/",
      "relatedApps": [
        {
          "url": "https://jumplink.eu/steuererklaerung/"
        },
        {
          "url": "https://jumplink.eu/Learn6502/"
        }
      ],
      "support": [
        {
          "kind": "GitHub Sponsors",
          "url": "https://github.com/sponsors/JumpLink"
        },
        {
          "kind": "Liberapay",
          "url": "https://liberapay.com/JumpLink"
        },
        {
          "kind": "PayPal",
          "url": "https://paypal.me/JumpLink"
        },
        {
          "kind": "sepa",
          "name": "JumpLink - Pascal Garber",
          "iban": "DE94100101232090324020"
        }
      ]
    }
  }
}
